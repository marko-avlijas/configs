[include]
    path = ~/.gitconfig_secret

[alias]
        aa = add --all
	co = checkout
	br = branch
	ci = commit
        cim = commit -m
        cam = commit -am
	ac = !git add -A && git commit -m
	st = status
	d = difftool

        # Cleanup merged branches
        bclean = "!f() { git branch --merged ${1-master} | grep -v " ${1-master}$" | xargs -r git branch -d; }; f"

	# log
        ls = log --pretty=format:"%C(yellow)%h%Cred%d\\ %Creset%s%Cblue\\ [%cn]" --decorate

        # with dates relative
        ld = log --pretty=format:"%C(yellow)%h\\ %ad%Cred%d\\ %Creset%s%Cblue\\ [%cn]" --decorate --date=relative

        # with graph, all branches
        lg = log --graph --all --decorate --pretty=format:"%C(yellow)%h%Cred%d\\ %Creset%s%Cblue\\ [%cn]"

        # with dates absolute
	lda = log --pretty=format:"%C(yellow)%h\\ %ad%Cred%d\\ %Creset%s%Cblue\\ [%cn]" --decorate --date=short

[push]
	default = simple
[core]
	excludesfile = ~/.gitignore_global
	pager = delta
[diff]
	tool = meld
[difftool]
	prompt = false
[difftool "meld"]
        cmd = meld "$LOCAL" "$REMOTE"
[merge]
	tool = meld
	conflictStyle = zdiff3
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	dark = true
        syntax-theme = Dracula
        line-numbers = true
        # A darker green behind added lines, so Dracula's grey-blue comments
        # keep their contrast there too (the theme cannot style comments alone).
        plus-style = syntax "#0b2a12"
        plus-emph-style = syntax "#1d4d26"
